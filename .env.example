# ============================================================
# Cyber Sentinel — Environment Configuration
# ============================================================
# Copy this file to .env (same directory):
#   cp .env.example .env
# Then fill in your actual values.
# ============================================================

# ---- App ----
DEBUG=true

# ---- First-boot Admin (REQUIRED on fresh install) ----
# Set these BEFORE the first `docker compose up` on a brand-new database.
# On startup, if no users exist, Cyber Sentinel creates one admin account using
# these credentials. After the first user is created these vars are ignored.
# ⚠ Change the password immediately after your first login.
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@lab.local
FIRST_ADMIN_PASSWORD=ChangeMe123!

# ---- MongoDB ----
# Docker (default): mongodb://cyber_sentinel:<password>@localhost:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cyber_sentinel
# MongoDB auth — required when running docker-compose (auth is enabled by default)
# Run the one-time migration BEFORE adding these: see docker-compose.yml header comment.
MONGO_USERNAME=cyber_sentinel
MONGO_PASSWORD=REPLACE_ME

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
# Redis auth password (set on the Redis server via --requirepass)
REDIS_PASSWORD=REPLACE_ME

# ---- JWT Authentication ----
# Generate a random secret:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# If left empty, a random key is auto-generated (sessions won't persist across restarts)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ---- Email (password reset) ----
# Gmail: enable 2FA, then generate an App Password at myaccount.google.com/apppasswords
# Outlook/Office365: SMTP_HOST=smtp.office365.com, PORT=587
# SendGrid: SMTP_HOST=smtp.sendgrid.net, PORT=587, USER=apikey, PASSWORD=your-sendgrid-api-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_USE_TLS=true

# ---- AI Provider ----
# Choose one: claude | groq | openai | gemini
# Claude (Anthropic) is the recommended provider — best reasoning for pentest reports and SOC triage.
# Groq (free tier, Llama 3.3 70B) is a good fallback if you don't have a Claude key.
AI_PROVIDER=claude

# ---- Claude AI (Anthropic) — RECOMMENDED ----
# Get your API key from: https://console.anthropic.com/
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# Optional: extra Claude keys for key-pool rotation (comma-separated, no spaces).
# When the active key hits its rate limit, the next key is tried immediately.
# Example: CLAUDE_API_KEYS=sk-ant-api03-secondkey,sk-ant-api03-thirdkey
CLAUDE_API_KEYS=

# ---- Groq AI (Llama 3.3 70B — free fallback) ----
# Get your FREE API key from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional extra Groq keys for key-pool rotation
GROQ_API_KEYS=

# ---- SOC AI Provider (optional dedicated provider for alert triage) ----
# Recommended: SOC_AI_PROVIDER=groq (free, handles continuous alert volume without eating Claude quota)
# Leave empty to share AI_PROVIDER for both SOC triage and pentest reports.
SOC_AI_PROVIDER=

# ---- NIST NVD (CVE lookup — optional) ----
# Get a free key from: https://nvd.nist.gov/developers/request-an-api-key
# Increases rate limit from 5 to 50 requests/30s
NVD_API_KEY=

# ---- Threat Intelligence (optional) ----
# VirusTotal: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# AbuseIPDB: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# ---- Wazuh SIEM (SOC side — optional) ----
# If Wazuh Manager runs on the SAME VM as Cyber Sentinel (native install, not Docker):
#   → docker-compose overrides this to https://host.docker.internal:55000 automatically.
#   → No change needed here for the standard 2-VM lab setup.
# If Wazuh Manager runs on a DIFFERENT host (remote):
#   → Set this to https://<wazuh-manager-ip>:55000
# ── Wazuh Manager ─────────────────────────────────────────────────────────────
# Lab VM running Wazuh Manager — admin manages, users NEVER configure this.
# API URL used by Cyber Sentinel backend for API calls (includes port).
WAZUH_API_URL=https://10.4.89.178:55000
# Use the API user — NOT indexer/dashboard users (admin, kibanaserver, wazuh-wui, etc.)
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=
WAZUH_VERIFY_SSL=false
# Public-facing IP/hostname that Wazuh agent docker-compose files point to.
# Students run: docker compose up -d  → agent connects here automatically.
# May differ from WAZUH_API_URL if behind NAT (no https:// or port here).
WAZUH_HOST_PUBLIC=10.4.89.178
# Agent registration password — find with: cat /var/ossec/etc/authd.pass on Wazuh VM
# Or set with: /var/ossec/bin/manage_agents
WAZUH_REG_PASSWORD=
# Shared secret for the Wazuh webhook endpoint (POST /api/alerts/webhook).
# Leave empty on isolated lab networks. Set a random token in production.
WAZUH_WEBHOOK_TOKEN=
#
# ── Wazuh ossec.conf integration block (paste into Wazuh Manager) ──────────
# This makes Wazuh PUSH alerts to Cyber Sentinel in real-time (recommended).
# Add inside <ossec_config> in /var/ossec/etc/ossec.conf, then restart Wazuh:
#   sudo systemctl restart wazuh-manager
#
# <integration>
#   <name>custom-webhook</name>
#   <hook_url>http://10.4.89.178/api/alerts/webhook</hook_url>
#   <level>3</level>
#   <alert_format>json</alert_format>
# </integration>
#
# Replace 10.4.89.178 with this VM's actual LAN IP.
# The /api/alerts/webhook endpoint is handled by the nginx reverse proxy.

# ---- OWASP ZAP ----
ZAP_SCAN_TIMEOUT=600
# ZAP API key — required; passed to ZAP daemon and to backend/celery for authenticated API calls
ZAP_API_KEY=REPLACE_ME

# ---- Observability ----
LOG_LEVEL=INFO

# ---- S3 Report Storage (optional — reports served from memory if unset) ----
# When S3_BUCKET is set, PDF/HTML reports are uploaded to S3 and served via
# pre-signed URLs. Leave empty to use in-memory serving (dev/staging default).
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REPORTS_PREFIX=reports/
S3_URL_EXPIRES=3600
ZAP_API_URL=http://localhost:8080

# ---- Frontend ----
FRONTEND_URL=http://localhost:5173

# ---- CORS (multi-user / network deployment) ----
# Comma-separated list of additional origins to allow.
# Use this when other machines on the network need to access the UI.
# Example: if the server is at 192.168.1.100 and the frontend runs there too:
# CORS_EXTRA_ORIGINS=http://192.168.1.100:5173,http://10.0.0.5:5173
CORS_EXTRA_ORIGINS=

# ---- Lab / Dev Mode ----
# Set to true ONLY in controlled lab environments (e.g. scanning DVWA, Juice Shop on local network).
# This bypasses private IP / internal hostname blocking (SSRF protection).
# NEVER set true on an internet-facing or production deployment.
ALLOW_PRIVATE_TARGETS=false

# ---- Demo User (seeded automatically on startup) ----
# A read-only demo account for supervisor walkthroughs and presentations.
# Leave empty to disable demo user seeding.
DEMO_USER_EMAIL=demo@its.ac.id
DEMO_USER_PASSWORD=demo1234
DEMO_JUICESHOP_URL=http://192.168.1.x:3000
DEMO_DVWA_URL=http://192.168.1.x:8080

# (Claude config is in the AI Provider section above)

# ---- Rate Limiting ----
# Format: "N/period"  where period = second | minute | hour | day
# All limits are per IP address, backed by Redis (shared across workers).
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_FORGOT_PASSWORD=5/hour
RATE_LIMIT_REGISTER=10/hour
RATE_LIMIT_SCAN=20/hour
# Per-user scan quota (checked by authenticated user ID, not IP)
SCAN_RATE_LIMIT=20
# Max scans a single user may have actively running/pending simultaneously.
# Prevents one user from flooding the Celery queue and starving others.
MAX_CONCURRENT_SCANS_PER_USER=3

